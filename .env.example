# Function configuration only. Do not put private keys in index.html.
# Use exact origins with no trailing slash; remove localhost before a public launch.
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Supabase injects SUPABASE_URL, SUPABASE_PUBLISHABLE_KEYS and
# SUPABASE_SECRET_KEYS into deployed functions. They are not set here.
